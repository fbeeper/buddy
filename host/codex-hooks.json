{
  "description": "Publish Codex session state to the RP2350 buddy display.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__PYTHON3__ __CODEX_HOOKS_DIR__/codex_buddy_hook.py",
            "timeout": 1
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__PYTHON3__ __CODEX_HOOKS_DIR__/codex_buddy_hook.py",
            "timeout": 1
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__PYTHON3__ __CODEX_HOOKS_DIR__/codex_buddy_hook.py",
            "timeout": 1
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__PYTHON3__ __CODEX_HOOKS_DIR__/codex_buddy_hook.py",
            "timeout": 1
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__PYTHON3__ __CODEX_HOOKS_DIR__/codex_buddy_hook.py",
            "timeout": 1
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__PYTHON3__ __CODEX_HOOKS_DIR__/codex_buddy_hook.py",
            "timeout": 1
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__PYTHON3__ __CODEX_HOOKS_DIR__/codex_buddy_hook.py",
            "timeout": 1
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__PYTHON3__ __CODEX_HOOKS_DIR__/codex_buddy_hook.py",
            "timeout": 1
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__PYTHON3__ __CODEX_HOOKS_DIR__/codex_buddy_hook.py",
            "timeout": 1
          }
        ]
      }
    ]
  }
}
